+    // macOS patch: F32-exact conv1d for the decomposed Metal path.
+    // ggml_conv_1d casts im2col to F16 (fatal for 40-layer waveform gen);
+    // this keeps the im2col buffer F32 to match conv_direct_1d_fused numerics.
+    static ggml_tensor * conv_1d_f32(ggml_context * c, ggml_tensor * w, ggml_tensor * x,
+                                     int stride, int pad, int dil) {
+        // stock im2col (battle-tested ordering) with explicit F32 buffer:
+        // fast_1d variant pairs with a different IC*K packing order -> noise (ablation-proven)
+        ggml_tensor * im2col = ggml_im2col(c, w, x, stride, 0, pad, 0, dil, 0, false, GGML_TYPE_F32);
