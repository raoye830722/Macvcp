index 7b71fe2..d45c4a3 100644
--- a/src/gsv_dit.cpp
+++ b/src/gsv_dit.cpp
@@ -185,7 +185,13 @@ struct gsv_dit::impl {
     // LN(x) * (1 + scale) + shift in one pass (patch op layernorm_affine, wb = [w, b]).
     static ggml_tensor * modulate_ln(ggml_context * c, ggml_tensor * x, ggml_tensor * scale,
                                      ggml_tensor * shift, ggml_tensor * ones) {
+        // macOS patch: GSV_DIT_NO_FUSE_LN=1 -> decompose to standard norm/mul/add (Metal path)
+        static const bool no_fuse = getenv("GSV_DIT_NO_FUSE_LN") != nullptr;
         ggml_tensor * w  = ggml_add(c, scale, ones);
+        if (no_fuse) {
+            ggml_tensor * ln = ggml_norm(c, x, NORM_EPS);
+            return ggml_add(c, ggml_mul(c, ln, w), shift);
+        }
         ggml_tensor * wb = ggml_concat(c, w, shift, 0);
         return ggml_layernorm_affine(c, x, nullptr, nullptr, wb, NORM_EPS);
     }
