# Configuration for LocalSearchController Plugin

# --- Paths ---
# [legacy 死配置] 当前代码未使用(HTTP模式与mdfind模式均不读取), 仅保留兼容。
EVERYTHING_ES_PATH="C:\\Program Files\\Everything\\Everything.exe"
EVERYTHING_PORT=80
# --- macOS mdfind (施工单 v1.1 Todo7) ---
# 默认搜索目录, 留空=全盘(与Everything语义一致)。设置后结果附scope提示。
MDFIND_DEFAULT_SCOPE=
# mdfind 查询超时毫秒数
MDFIND_TIMEOUT_MS=10000
# --- Behavior ---
# Enable debug mode for more verbose logging to stderr. (true/false)
DEBUG_MODE="true"
